#!/bin/sh
# Enable the audio bring-up service (binds LPASS devices, registers the
# q6apm sound card and applies the UCM HiFi verb), the DP-audio hotplug
# sync (re-probes the DisplayPort output when a USB-C monitor is attached)
# and the internal-mic capture state (the UCM "Mic" sequence never runs with
# api.alsa.use-acp=false, so it would otherwise stay at the driver default =
# muted, and every recording would be silence).
set -e

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
	systemctl enable --now erhai-audio-bringup.service || true
	systemctl enable erhai-dp-audio-sync.service || true
	# --now: apply the mic state in this very session too (idempotent).
	systemctl enable --now erhai-mic-state.service || true
	if command -v udevadm >/dev/null 2>&1; then
		udevadm control --reload || true
	fi
else
	# Image build chroot: enable via the wants symlinks directly.
	mkdir -p /etc/systemd/system/multi-user.target.wants
	ln -sf ../erhai-audio-bringup.service \
		/etc/systemd/system/multi-user.target.wants/erhai-audio-bringup.service
	ln -sf ../erhai-dp-audio-sync.service \
		/etc/systemd/system/multi-user.target.wants/erhai-dp-audio-sync.service
	ln -sf ../erhai-mic-state.service \
		/etc/systemd/system/multi-user.target.wants/erhai-mic-state.service
fi

exit 0
