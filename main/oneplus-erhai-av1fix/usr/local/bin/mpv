#!/bin/sh
# Run mpv with the private AV1 client stack.
#
# libavcodec submits AV1 as headerless tile payloads; the driver can only learn
# the per-picture refresh set through the libva extension this package carries.
# Prepending the private lib directory makes this process load that libva and
# libav* instead of Ubuntu's; the rest of the system is unaffected.
AV1FIX=/opt/oneplus-erhai-av1fix/lib
LD_LIBRARY_PATH="$AV1FIX${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
exec /usr/bin/mpv "$@"
