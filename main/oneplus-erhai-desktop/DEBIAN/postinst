#!/bin/bash
set -e

# erhai: finger-drag scrolling for the Ubuntu Dock (touch-scroll patch,
# 2026-10-04).  The dock is a GNOME SESSION-MODE extension, so a per-user
# override is refused and the patched dash.js must sit at the extension's own
# system path -- a path owned by gnome-shell-ubuntu-extensions.  A file from
# this package at that path would be a dpkg file CONFLICT, so install ours with
# dpkg-divert: Ubuntu's file is kept as dash.js.erhai-orig and an upgrade of
# gnome-shell-ubuntu-extensions writes to the diverted name, so it can never
# clobber the patch.  DEBIAN/postrm drops the diversion again.
#
# The diversion is registered WITHOUT --rename and we keep Ubuntu's original
# ourselves: `dpkg-divert --remove --rename` refuses to overwrite a different
# existing file, so the --rename round trip can fail on removal and leave the
# dock with NO dash.js (measured 2026-10-04).  postrm therefore just copies
# dash.js.erhai-orig back.
#
# This runs OUTSIDE the systemd guard below so an image build (chroot, no
# systemd) applies it too.
DOCK_EXT_DIR=/usr/share/gnome-shell/extensions/ubuntu-dock@ubuntu.com
DOCK_DASH="$DOCK_EXT_DIR/dash.js"
DOCK_ORIG="$DOCK_DASH.erhai-orig"
DOCK_PAYLOAD=/usr/share/oneplus-erhai-desktop/ubuntu-dock-dash.js
if [ -d "$DOCK_EXT_DIR" ] && [ -f "$DOCK_PAYLOAD" ]; then
	# Save Ubuntu's original once -- but never our own patched file (it
	# carries the _initTouchScroll marker), so a re-install cannot turn the
	# patched file into "the original".
	if [ ! -f "$DOCK_ORIG" ] && [ -f "$DOCK_DASH" ] &&
	   ! grep -q '_initTouchScroll' "$DOCK_DASH" 2>/dev/null; then
		cp -a "$DOCK_DASH" "$DOCK_ORIG" 2>/dev/null || true
	fi
	dpkg-divert --package oneplus-erhai-desktop --add --no-rename \
		--divert "$DOCK_ORIG" "$DOCK_DASH" >/dev/null 2>&1 || true
	install -o root -g root -m 0644 "$DOCK_PAYLOAD" "$DOCK_DASH" || true
fi

# erhai: touch long-press -> context menu for the Desktop Icons NG extension
# (2026-10-04).  DING opens its context menus only on a secondary (mouse)
# button press; a touch long tap arrives as an emulated primary (button 1)
# press, so the menu never opened with a finger.  ding@rastersoft.com belongs
# to gnome-shell-ubuntu-extensions, so the patched files are installed with
# dpkg-divert (Ubuntu's originals kept as *.erhai-orig), exactly like the dock
# patch above -- a plain file at the extension's own path would be a dpkg file
# conflict and an upgrade of gnome-shell-ubuntu-extensions could clobber it.
# DEBIAN/postrm drops the diversions again.
DING_EXT_DIR=/usr/share/gnome-shell/extensions/ding@rastersoft.com
DING_PAYLOAD_DIR=/usr/share/oneplus-erhai-desktop/ding-touch
for DING_REL in app/desktopGrid.js app/desktopManager.js app/desktopIconItem.js; do
	DING_FILE="$DING_EXT_DIR/$DING_REL"
	DING_ORIG="$DING_FILE.erhai-orig"
	DING_PAYLOAD="$DING_PAYLOAD_DIR/$DING_REL"
	[ -d "$DING_EXT_DIR" ] && [ -f "$DING_PAYLOAD" ] || continue
	# Save Ubuntu's original once -- but never our own patched file (it
	# carries the _initTouchLongPress marker), so a re-install cannot turn
	# the patched file into "the original".
	if [ ! -f "$DING_ORIG" ] && [ -f "$DING_FILE" ] &&
	   ! grep -q '_initTouchLongPress' "$DING_FILE" 2>/dev/null; then
		cp -a "$DING_FILE" "$DING_ORIG" 2>/dev/null || true
	fi
	dpkg-divert --package oneplus-erhai-desktop --add --no-rename \
		--divert "$DING_ORIG" "$DING_FILE" >/dev/null 2>&1 || true
	install -o root -g root -m 0644 "$DING_PAYLOAD" "$DING_FILE" || true
done

if [ -d /run/systemd/system ]; then
	if command -v dconf >/dev/null 2>&1; then
		dconf update || true
	fi
	systemctl daemon-reload >/dev/null 2>&1 || true
	# erhai-gpu-pin.service is NOT in this list any more: which of the two GPU
	# pin policies is armed depends on /etc/erhai/gpu-pin.conf (see the block
	# below).
	for unit in erhai-desktop-gl.service \
	            erhai-host-charge.service erhai-power-toggle.service \
	            erhai-pogo-osk.service erhai-touchscreen.service \
	            erhai-backlight.service erhai-greeter-brightness.service \
	            erhai-rtc-sync.service erhai-bypass-charge.service; do
		systemctl enable "$unit" >/dev/null 2>&1 || true
	done
	# ------------------------------------------------------- GPU pin policy ---
	# 2.25 (2026-10-24 owner workaround): the Adreno is no longer pinned
	# forever by default.  /etc/erhai/gpu-pin.conf (a conffile) decides:
	#   MODE=once    erhai-gpu-pin-once.service pins the GPU for the BOOT
	#                BRING-UP only (before gdm) and releases it to runtime-PM
	#                'auto' once gdm runs, the panel is lit and the GPU clock
	#                has risen above its idle floor (settled SETTLE seconds) —
	#                an unpinned boot could not bring the desktop up, a
	#                permanently pinned GPU makes the DRM recovery a no-op.
	#   MODE=always  the pre-2.25 permanent pin (erhai-gpu-pin.service).
	# Exactly ONE of the two is enabled, so a boot can never run both.
	GPU_PIN_CONF=${ERHAI_GPU_PIN_CONF:-/etc/erhai/gpu-pin.conf}
	GPU_MODE=$(sed -n 's/^[[:space:]]*MODE[[:space:]]*=[[:space:]]*//p' \
		"$GPU_PIN_CONF" 2>/dev/null | tail -n1 | tr -d '\r ' | tr 'A-Z' 'a-z')
	case "$GPU_MODE" in
	always)
		systemctl enable erhai-gpu-pin.service >/dev/null 2>&1 || true
		systemctl disable erhai-gpu-pin-once.service >/dev/null 2>&1 || true
		;;
	*)
		systemctl enable erhai-gpu-pin-once.service >/dev/null 2>&1 || true
		systemctl disable erhai-gpu-pin.service >/dev/null 2>&1 || true
		;;
	esac

	# erhai: bypass charging (GNOME Quick Settings switch).
	#   * erhai-bypass-charge.service is the holder: it re-applies the persisted
	#     choice from /etc/default/erhai-charge and re-asserts the ADSP
	#     charge-enable inhibit every poll (the ADSP clears it on its own charge
	#     events),
	#   * erhai-bypass-charge@<on|off>.service is the oneshot the extension
	#     starts (polkit, 50-erhai-bypass-charge.rules).
	# Restarted here so an install/upgrade takes effect immediately; a fresh
	# install has ERHAI_BYPASS_CHARGE=0 and the holder just idles.  The state
	# file is a conffile, so an upgrade never overwrites a user's choice.
	systemctl restart erhai-bypass-charge.service >/dev/null 2>&1 || true
	# erhai: battery-backed clock (kernel +b8 DTB offset cell).
	#   * erhai-rtc-sync.service stores the system clock in the PMK8550 PMIC RTC
	#     once per boot (a no-op when hctosys just read the same value),
	#   * erhai-rtc-sync.timer re-runs it hourly, so an NTP correction reaches
	#     the RTC without waiting for the next reboot.
	# On a pre-+b8 kernel the helper logs "kernel has no RTC offset storage"
	# and exits 0, so this is safe on older kernels too.
	systemctl enable --now erhai-rtc-sync.timer >/dev/null 2>&1 || true
	systemctl restart erhai-rtc-sync.service >/dev/null 2>&1 || true
	# erhai: fixed backlight level for boot and the login screen.
	#   * erhai-backlight.service one-shots the boot level (before gdm),
	#   * erhai-greeter-brightness.py re-pins it whenever a greeter session
	#     appears after a logout, and keeps it pinned while one is on screen.
	# The backlight unit is deliberately NOT started here: it would change the
	# level of a session that is already running.  The watcher changes nothing
	# until a greeter session exists.  (restart, not `try-restart || start`:
	# try-restart on an inactive-but-loaded unit SUCCEEDS as a no-op, so the
	# start would never run on a first install.)
	systemctl restart erhai-greeter-brightness.service \
		>/dev/null 2>&1 || true
	# The greeter's file-db (/var/lib/gdm3/greeter-dconf-defaults) is compiled by
	# gdm's own ExecStartPre from /usr/share/gdm/dconf, which now carries
	# 95-erhai-greeter (greeter session-name + GNOME ALS off).  Recompile it here
	# so a running gdm is covered without waiting for its next start.
	if [ -x /usr/share/gdm/generate-config ]; then
		/usr/share/gdm/generate-config >/dev/null 2>&1 || true
	fi
	# 99-erhai-no-gsd-ambient.gschema.override: dpkg triggers normally recompile
	# the schema cache; do it explicitly as well (idempotent).
	if command -v glib-compile-schemas >/dev/null 2>&1; then
		glib-compile-schemas /usr/share/glib-2.0/schemas \
			>/dev/null 2>&1 || true
	fi
	# erhai-folio-gate.service is deliberately NOT in the loop above: it is the
	# pre-b46 fallback and is (re)armed only by the version check below.
	# erhai-folio-fold.service is deliberately NOT enabled: the udev rules
	# (71-erhai-folio-udev.rules) own its lifecycle on kernels whose pogo-kbd
	# driver emits the attach/detach uevent (>= +b46).  The 1 Hz
	# erhai-folio-gate.service is only the pre-b46 FALLBACK, so it is enabled
	# on old kernels / unknown states (e.g. an image build where the kernel
	# package is not yet queryable) but must never be re-armed by an upgrade
	# on a uevent kernel once the owner disabled it.
	KERN_DEB=$(dpkg-query -W -f='${Version}' oneplus-erhai-linux-7.2 \
		2>/dev/null || true)
	KERN_B=$(printf '%s\n' "$KERN_DEB" \
		| sed -n 's/.*+b\([0-9][0-9]*\).*/\1/p')
	if [ -n "$KERN_B" ] && [ "$KERN_B" -ge 46 ] 2>/dev/null; then
		:   # uevent kernel: udev drives the watcher, no gate needed
	else
		systemctl enable --now erhai-folio-gate.service \
			>/dev/null 2>&1 || true
	fi
	systemctl try-restart erhai-folio-gate.service >/dev/null 2>&1 || true
	# erhai: ONE owner-tagged blank state since 2.20 (/run/erhai-panel.state,
	# "<owner> <epoch>") instead of the two markers /run/erhai-panel-off and
	# /run/erhai-folio-fold-blanked that every consumer had to test separately.
	# erhai-panel-state-migrate.sh translates a blank that is in force RIGHT NOW
	# (an upgrade in a live session must not lose it) and drops the old markers;
	# the two watchers are then restarted so the code in memory cannot keep
	# writing them.  /run is volatile, so a fresh boot has no state either way.
	/usr/local/sbin/erhai-panel-state-migrate.sh || true
	systemctl try-restart erhai-power-toggle.service >/dev/null 2>&1 || true
	systemctl try-restart erhai-folio-fold.service >/dev/null 2>&1 || true
	# erhai: GPU WEDGE WATCHDOG — RETIRED (2.28, owner decision 2026-10-24).
	# 2.27/2.28 shipped erhai-gpu-watch.service, which SIGKILLed a task that kept
	# hanging the Adreno.  It could NOT clear the real Waydroid wedge (a GPU reset
	# cannot retire a submit held by an unreaped zombie), the investigation cost
	# far more than the daemon ever did (0.376 s CPU per 30 min, 11 MB RSS), and
	# the owner had it turned off.  The payload is gone from this package, so an
	# upgrade from 2.27/2.28 must undo what those versions armed: stop + disable
	# the unit, drop the wants symlink dpkg cannot own, and delete the script,
	# unit, conffile and per-boot state the new payload no longer ships.
	# --no-reload everywhere: dpkg has already asked for one, and the 2.27
	# postinst's implicit reloads cost a measured 14-reload storm.
	if [ -e /etc/systemd/system/erhai-gpu-watch.service ] || \
	   [ -e /etc/systemd/system/multi-user.target.wants/erhai-gpu-watch.service ]; then
		systemctl disable --now --no-reload erhai-gpu-watch.service \
			>/dev/null 2>&1 || true
	fi
	rm -f /etc/systemd/system/multi-user.target.wants/erhai-gpu-watch.service
	rm -f /etc/systemd/system/erhai-gpu-watch.service \
	      /usr/local/sbin/erhai-gpu-watch.py \
	      /etc/erhai/gpu-watch.conf
	rm -f /run/erhai-gpu-watch.log /run/erhai-gpu-watch.state
	if [ -d /run/udev ]; then
		# Re-apply the pogo touchpad integration tag on the running system
		# (the pinned tablet-mode kernel + libinput need the touchpad
		# tagged external; on older kernels this is a harmless no-op).
		udevadm trigger --action=change --subsystem-match=input \
			>/dev/null 2>&1 || true
		# Fire the folio-fold udev rule for the keyboard's current state so
		# the watcher starts without waiting for an attach/detach edge.
		udevadm trigger --action=change --subsystem-match=serial \
			>/dev/null 2>&1 || true
		# 72-erhai-gpu-external.rules: if an external display is connected
		# right now, re-pin the GPU (the power-button blank parks it, and a
		# monitor must never find it parked).
		udevadm trigger --action=change --subsystem-match=drm \
			>/dev/null 2>&1 || true
	fi
fi
udevadm control --reload >/dev/null 2>&1 || true

# ---------------------------------------------------------- autologin keyring ---
# erhai: own the AUTOLOGIN LOGIN-KEYRING UNLOCK (2.24).  gdm-autologin has no
# password to hand pam_gnome_keyring, so the login keyring stays locked and the
# first client that reads a secret (goa-daemon, Brave/Chromium "Safe Storage")
# pops a gcr prompt at every login.  /usr/local/sbin/erhai-keyring-unlock.sh --
# shipped by THIS package since 2.24 and USERNAME-FREE (it takes the account from
# PAM_USER) -- unlocks it from /etc/erhai/keyring.pass.
#
# /etc/pam.d/gdm-autologin belongs to gdm3, so exactly ONE line is managed here:
# inserted BEFORE pam_gnome_keyring's auto_start (gnome-keyring-daemon can only be
# STARTED with the password, it cannot unlock a daemon that is already running --
# measured 2026-09-20), idempotently, never rewriting the rest of the file.  This
# runs OUTSIDE the systemd guard below on purpose: an image build (chroot) needs
# the line too.  It closes the KNOWN GAP tracked in build-root.sh since 2026-09-28.
#
# 2.30: gdm-PASSWORD carries the same line.  gnome-keyring 50.0-1's own unlock
# path -- what pam_gnome_keyring uses when it HAS the password -- rejects the
# CORRECT password ("gkr-pam: the password for the login keyring was invalid",
# measured 2026-10-26 on a keyring this same daemon then unlocked from the
# command line with the very same password; the D-Bus
# InternalUnsupportedGuiltRiddenInterface methods are broken the same way), so
# after a manual login the keyring stayed locked and the first app that read a
# secret popped the gcr "password no longer matches" prompt, which could not
# unlock it either.  The helper starts the daemon with `--unlock`, the path that
# verifies correctly, so it must run before pam_gnome_keyring's auto_start here
# too.  Consequence (unchanged from autologin, now also for password logins):
# /etc/erhai/keyring.pass must hold the password that unlocks the keyring.
PAM_DIR=${ERHAI_PAM_DIR:-/etc/pam.d}
PAM_FILES='gdm-autologin gdm-password'
PAM_LINE='session optional        pam_exec.so seteuid /usr/local/sbin/erhai-keyring-unlock.sh'
PAM_ANCHOR='^session[[:space:]]+optional[[:space:]]+pam_gnome_keyring\\.so'
PAM_MARKER='erhai-keyring-unlock.sh'          # any line that mentions our helper
pam_install_line() {
	[ -f "$PAM_FILE" ] || return 0            # no gdm config, nothing to own
	if grep -qF "$PAM_MARKER" "$PAM_FILE"; then
		return 0                          # already ours (idempotent)
	fi
	local tmp err
	tmp=$(mktemp "$PAM_DIR/.erhai-pam.XXXXXX") || return 1
	if awk -v line="$PAM_LINE" -v anchor="$PAM_ANCHOR" '
			!done && $0 ~ anchor { print line; done = 1 }
			{ print }
			END { if (!done) print line }' "$PAM_FILE" > "$tmp"; then
		# keep the original's owner/mode (numeric: this image's coreutils is the
		# Rust uutils build -- --reference works, but numbers are unambiguous)
		chmod "$(stat -c %a "$PAM_FILE" 2>/dev/null || echo 644)" "$tmp" 2>/dev/null || true
		chown "$(stat -c %u "$PAM_FILE" 2>/dev/null || echo 0):$(stat -c %g "$PAM_FILE" 2>/dev/null || echo 0)" \
			"$tmp" 2>/dev/null || true
		mv -f "$tmp" "$PAM_FILE" 2>/dev/null || { rm -f "$tmp"; return 1; }
		return 0
	fi
	rm -f "$tmp"
	return 1
}
for PAM_NAME in $PAM_FILES; do
	PAM_FILE=$PAM_DIR/$PAM_NAME
	pam_install_line \
		|| echo "oneplus-erhai-desktop: could not add the keyring-unlock pam line to $PAM_FILE" >&2
done

# /etc/erhai/keyring.pass is NOT the package's to create: it holds the password
# that unlocks the login KEYRING, which only the user knows (see
# sensor-MEMORY-2026-10-22.md §10).  Its documented contract is
# root:<desktop-user> 0640, so a file whose group names NO human account (an image
# with no account at install time, a renamed account, a chmod accident) is put
# back on that contract; a file already owned by a human account's group is left
# alone -- it names the account it was set up for.
if [ -f /etc/erhai/keyring.pass ] && [ -r /usr/local/sbin/erhai-desktop-users.sh ]; then
	# shellcheck disable=SC1091
	. /usr/local/sbin/erhai-desktop-users.sh || true
	KP_GID=$(stat -c %g /etc/erhai/keyring.pass 2>/dev/null || echo 0)
	KP_HUMAN=$(getent passwd 2>/dev/null | awk -F: -v g="$KP_GID" '$4 == g { print "yes"; exit }')
	KP_USER=$(erhai_session_user cheap 2>/dev/null | cut -d: -f1 || true)
	if [ -z "$KP_HUMAN" ] && [ -n "$KP_USER" ]; then
		chown "root:$KP_USER" /etc/erhai/keyring.pass 2>/dev/null || true
		chmod 640 /etc/erhai/keyring.pass 2>/dev/null || true
		echo "oneplus-erhai-desktop: /etc/erhai/keyring.pass re-grouped to $KP_USER (0640)" >&2
	fi
fi

exit 0
