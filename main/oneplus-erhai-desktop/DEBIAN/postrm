#!/bin/bash
# erhai: undo the Ubuntu Dock touch-scroll diversion (see DEBIAN/postinst).
#
# postinst diverted /usr/share/gnome-shell/extensions/ubuntu-dock@ubuntu.com/
# dash.js so this package's patched copy could sit at that path without a dpkg
# file conflict.  On a real removal (not an upgrade) the diversion must go
# again, otherwise the path stays diverted and the stock dash.js would never be
# restored -- the dock extension would then load with NO dash.js at all.
#
# The diversion was registered WITHOUT --rename, so dpkg-divert does not touch
# files here; we copy Ubuntu's saved original (dash.js.erhai-orig) back over the
# patched copy ourselves.  (`dpkg-divert --remove --rename` cannot be used: it
# refuses to overwrite the different existing dash.js -- measured 2026-10-04.)
set -e

DOCK_EXT_DIR=/usr/share/gnome-shell/extensions/ubuntu-dock@ubuntu.com
DOCK_DASH="$DOCK_EXT_DIR/dash.js"
DOCK_ORIG="$DOCK_DASH.erhai-orig"

# erhai: drop the keyring-unlock pam lines this package's postinst added to
# /etc/pam.d/gdm-autologin (2.24) and /etc/pam.d/gdm-password (2.30).  Only OUR
# lines go -- the files belong to gdm3 and must keep working for a normal
# password login.  The pass file
# /etc/erhai/keyring.pass is the USER's (it holds the keyring password) and is
# never touched here.
PAM_DIR=${ERHAI_PAM_DIR:-/etc/pam.d}
# 2.30 added the same line to gdm-password; both must go on removal.
PAM_FILES='gdm-autologin gdm-password'
pam_remove_line() {
	[ -f "$PAM_FILE" ] || return 0
	grep -qF 'erhai-keyring-unlock.sh' "$PAM_FILE" || return 0
	local tmp
	tmp=$(mktemp "$(dirname "$PAM_FILE")/.erhai-pam.XXXXXX") || return 1
	grep -vF 'erhai-keyring-unlock.sh' "$PAM_FILE" > "$tmp" || true
	chmod "$(stat -c %a "$PAM_FILE" 2>/dev/null || echo 644)" "$tmp" 2>/dev/null || true
	chown "$(stat -c %u "$PAM_FILE" 2>/dev/null || echo 0):$(stat -c %g "$PAM_FILE" 2>/dev/null || echo 0)" \
		"$tmp" 2>/dev/null || true
	mv -f "$tmp" "$PAM_FILE" 2>/dev/null || { rm -f "$tmp"; return 1; }
	return 0
}

case "$1" in
remove|purge)
	dpkg-divert --remove --no-rename \
		--divert "$DOCK_ORIG" "$DOCK_DASH" >/dev/null 2>&1 || true
	if [ -f "$DOCK_ORIG" ]; then
		cp -f "$DOCK_ORIG" "$DOCK_DASH" >/dev/null 2>&1 || true
	elif [ ! -f "$DOCK_DASH" ]; then
		echo "oneplus-erhai-desktop: warning: no $DOCK_DASH and no saved" >&2
		echo "  original -- reinstall gnome-shell-ubuntu-extensions" >&2
	fi

	# erhai: undo the DING touch long-press diversions (see DEBIAN/postinst).
	DING_EXT_DIR=/usr/share/gnome-shell/extensions/ding@rastersoft.com
	for DING_REL in app/desktopGrid.js app/desktopManager.js app/desktopIconItem.js; do
		DING_FILE="$DING_EXT_DIR/$DING_REL"
		DING_ORIG="$DING_FILE.erhai-orig"
		dpkg-divert --remove --no-rename \
			--divert "$DING_ORIG" "$DING_FILE" >/dev/null 2>&1 || true
		if [ -f "$DING_ORIG" ]; then
			cp -f "$DING_ORIG" "$DING_FILE" >/dev/null 2>&1 || true
		elif [ ! -f "$DING_FILE" ]; then
			echo "oneplus-erhai-desktop: warning: no $DING_FILE and no" >&2
			echo "  saved original -- reinstall gnome-shell-ubuntu-extensions" >&2
		fi
	done

	for PAM_NAME in $PAM_FILES; do
		PAM_FILE=$PAM_DIR/$PAM_NAME
		pam_remove_line \
			|| echo "oneplus-erhai-desktop: could not drop the keyring-unlock pam line from $PAM_FILE" >&2
	done

	# erhai: GPU pin policy (2.25).  erhai-gpu-pin-once.service is enabled by
	# this package's postinst, so a removal must not leave its dangling
	# multi-user.target.wants link behind; if the pre-2.25 permanent pin is
	# still on disk, re-arm it so the pad is never left with an unpinned Adreno
	# and no policy at all.
	if [ -d /run/systemd/system ]; then
		# 2.28: the 2.27/2.28 GPU wedge watchdog is retired, so this package
		# ships no file for it any more — nothing to disable here.  (An upgrade
		# FROM 2.27/2.28 is cleaned up by this package's postinst.)
		rm -f /etc/systemd/system/multi-user.target.wants/erhai-gpu-pin-once.service
		if [ -e /etc/systemd/system/erhai-gpu-pin.service ]; then
			systemctl enable erhai-gpu-pin.service >/dev/null 2>&1 || true
		fi
		systemctl daemon-reload >/dev/null 2>&1 || true
	fi
	;;
esac

exit 0
