#!/bin/sh
# ath12k is the only backend. This package no longer ships the vendor
# cnss2/qcacld units, so clean up after the versions that did: stop the loaded
# units, drop the enable symlinks `systemctl enable` created under /etc (dpkg
# does not own those), then reload. Otherwise systemd logs "unit not found" at
# every boot and the old discovery sweeper keeps scanning.
set -e

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
	# The unit files are already gone from disk at this point, but systemd
	# still has the old definitions loaded until the daemon-reload below.
	systemctl stop erhai-wifi-discover.service 2>/dev/null || true
	systemctl stop erhai-wcn-wifi.service 2>/dev/null || true
	systemctl stop erhai-wcn-devcd.service 2>/dev/null || true
	systemctl stop erhai-wcn-holdfloor.service 2>/dev/null || true
fi

rm -f /etc/systemd/system/multi-user.target.wants/erhai-wcn-wifi.service \
      /etc/systemd/system/multi-user.target.wants/erhai-wcn-devcd.service \
      /etc/systemd/system/multi-user.target.wants/erhai-wifi-discover.service \
      /etc/systemd/system/sysinit.target.wants/erhai-wcn-holdfloor.service

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
fi

# ath12k itself needs no unit: udev binds ath12k_pci to 0000:01:00.0 and
# NetworkManager manages wlp1s0. The firmware comes from oneplus-erhai-firmware
# (>= 1.4); say so loudly if it is missing, the module will fail with "no
# firmware" otherwise.
if [ ! -f /usr/lib/firmware/ath12k/WCN7860/hw2.0/board-2.bin ]; then
	echo "warning: /usr/lib/firmware/ath12k/WCN7860/hw2.0/board-2.bin is missing;" >&2
	echo "         install oneplus-erhai-firmware 1.4 or newer, ath12k needs it." >&2
fi

exit 0
