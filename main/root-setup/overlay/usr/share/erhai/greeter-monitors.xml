<monitors version="2">
<!-- erhai greeter seed: one configuration per panel rate. Mutter matches
     configurations INCLUDING refresh rate: a single-rate file makes the
     login screen fall back to scale 1 whenever the panel comes up at
     another rate. First match wins; preferred rate (120) goes first. -->
  <configuration>
    <layoutmode>logical</layoutmode>
    <logicalmonitor>
      <x>0</x>
      <y>0</y>
      <scale>2</scale>
      <primary>yes</primary>
      <monitor>
        <monitorspec>
          <connector>DSI-1</connector>
          <vendor>unknown</vendor>
          <product>unknown</product>
          <serial>unknown</serial>
        </monitorspec>
        <mode>
          <width>3392</width>
          <height>2400</height>
          <rate>120.000</rate>
        </mode>
      </monitor>
    </logicalmonitor>
  </configuration>
