# erhai: the workspace-switch shortcuts follow the POINTER, like the gesture
#
# Workspace Islands v0.1.2 resolves every keyboard shortcut with
# Registry.forFocusedMonitor(), so Super+Alt+Arrow only ever rotates the
# monitor that holds the focused window (and does nothing on the primary).
# On the pad the focus usually sits on the primary, so the stock GNOME
# binding switched the internal display no matter where the pointer was.
#
# Two changes, both marked [erhai] in the code:
#  1. the extension switch handlers resolve Registry.forPointerMonitor();
#  2. GNOME own switch-to-workspace-{left,right,up,down} handlers are
#     replaced while the extension is enabled: pointer over a secondary ->
#     rotate that monitor and SUPPRESS the native (primary) switch, anywhere
#     else -> call the shell own _showWorkspaceSwitcher unchanged.  Without
#     the suppression one press moved both displays, because the extension
#     and GNOME bind the same accelerators; the extension own switch-next/
#     switch-prev binding is therefore only registered when its accelerator
#     is NOT one of the stock ones.
#
# Apply inside the extension directory:
#   cd oneplus-erhai-ubuntu/main/root-setup/overlay/usr/share/gnome-shell/extensions/workspace-islands@danielbernalo.github.io
#   patch -p0 < ../../../../../../main/workspace-islands-pointer-shortcuts.patch
#
--- extension.js
+++ extension.js
@@ -11,6 +11,7 @@
 
 import Gio from 'gi://Gio';
 import GLib from 'gi://GLib';
+import Shell from 'gi://Shell';
 
 import * as Main from 'resource:///org/gnome/shell/ui/main.js';
