+        spec_dev.assign(n_layer_all + 1, nullptr);
+
+        auto dev_by_name = [&](const std::string & name) -> ggml_backend_dev_t {
+            for (const auto & d : devices) {
+                if (iequals(ggml_backend_dev_name(d.dev), name.c_str())) {
+                    return d.dev;
+                }
+            }
+            return nullptr;
+        };
+
+        auto is_cpu_name = [&](const std::string & name) {
+            return iequals(name.c_str(), "cpu") || iequals(name.c_str(), "host") || iequals(name.c_str(), "none");
