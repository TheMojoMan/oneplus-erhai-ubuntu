+    // ------------------------------------------------------------------
+    // Decides the device of every layer (0..n_layer_all, n_layer_all = output layer) up
+    // front, so placement no longer depends on n_gpu_layers, on tensor_split or on the
+    // free memory a backend reports.
+    std::vector<ggml_backend_dev_t> spec_dev;
+    if (params.offload_spec != nullptr && params.offload_spec[0] != '\0') {
+        std::string err;
+        const std::vector<llama_offload_spec_rule> rules = llama_offload_spec_parse(params.offload_spec, &err);
+        if (!err.empty() || rules.empty()) {
+            throw std::runtime_error(err.empty() ? std::string("offload-spec: no rules") : err);
+        }
+
+        auto iequals = [](const char * a, const char * b) {
+            while (*a != '\0' && *b != '\0') {
+                if (std::tolower((unsigned char) *a) != std::tolower((unsigned char) *b)) {
+                    return false;
+                }
+                ++a;
+                ++b;
+            }
+            return *a == *b;
