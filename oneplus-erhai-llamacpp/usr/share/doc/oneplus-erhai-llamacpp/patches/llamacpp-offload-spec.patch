+        b++;
+    }
+    while (e > b && std::isspace((unsigned char) s[e - 1])) {
+        e--;
+    }
+    return s.substr(b, e - b);
+}
+
+static std::string lower(const std::string & s) {
+    std::string r = s;
+    for (char & c : r) {
+        c = (char) std::tolower((unsigned char) c);
+    }
+    return r;
+}
+
+int64_t llama_offload_spec_parse_bytes(const std::string & value) {
+    if (value.empty()) {
+        throw std::invalid_argument("empty byte count");
+    }
+    size_t n = 0;
+    while (n < value.size() && std::isdigit((unsigned char) value[n])) {
+        n++;
+    }
+    if (n == 0) {
+        throw std::invalid_argument("byte count '" + value + "' does not start with a number");
+    }
+    const int64_t num  = std::strtoll(value.substr(0, n).c_str(), nullptr, 10);
+    const std::string suffix = lower(trim(value.substr(n)));
+    int64_t mul = 1;
+    if      (suffix.empty() || suffix == "b") { mul = 1; }
+    else if (suffix == "k" || suffix == "kb" || suffix == "kib") { mul = 1024; }
+    else if (suffix == "m" || suffix == "mb" || suffix == "mib") { mul = 1024 * 1024; }
+    else if (suffix == "g" || suffix == "gb" || suffix == "gib") { mul = 1024 * 1024 * 1024; }
+    else if (suffix == "t" || suffix == "tb" || suffix == "tib") { mul = (int64_t) 1024 * 1024 * 1024 * 1024; }
+    else {
+        throw std::invalid_argument("unknown byte suffix '" + suffix + "'");
+    }
+    return num * mul;
+}
+
+std::vector<llama_offload_spec_rule> llama_offload_spec_parse(const char * spec, std::string * err) {
+    std::vector<llama_offload_spec_rule> rules;
+    if (spec == nullptr || *spec == '\0') {
+        return rules;
+    }
+
+    auto fail = [&](const std::string & msg) {
+        const std::string full = std::string("offload-spec: ") + msg;
+        if (err) {
+            *err = full;
+            return std::vector<llama_offload_spec_rule>();
+        }
+        throw std::invalid_argument(full);
+    };
+
+    std::string s(spec);
+    for (char & c : s) {
+        if (c == ';') {
+            c = ',';
+        }
+    }
+
+    std::vector<std::string> parts;
+    {
+        std::string cur;
+        for (char c : s) {
+            if (c == ',') {
+                parts.push_back(cur);
+                cur.clear();
+            } else {
+                cur += c;
+            }
+        }
+        parts.push_back(cur);
+    }
+
+    for (size_t i = 0; i < parts.size(); i++) {
+        const std::string rule = trim(parts[i]);
+        if (rule.empty()) {
+            continue;
+        }
+        const size_t colon = rule.find(':');
+        if (colon == std::string::npos) {
+            return fail("rule '" + rule + "' has no device (expected <device>:<what>)");
+        }
+        llama_offload_spec_rule r;
+        r.device = trim(rule.substr(0, colon));
+        r.pos    = (int) i;
+        const std::string what = trim(rule.substr(colon + 1));
+        if (r.device.empty() || what.empty()) {
+            return fail("rule '" + rule + "' is incomplete");
+        }
+
+        const std::string what_l = lower(what);
+        if (what_l == "rest" || what_l == "all" || what_l == "leftover") {
+            r.kind = llama_offload_spec_rule::KIND_REST;
+        } else if (what_l.rfind("layers=", 0) == 0) {
+            const std::string v = trim(what.substr(7));
+            const size_t dash = v.find('-');
+            if (dash == std::string::npos) {
+                r.kind  = llama_offload_spec_rule::KIND_LAYERS_COUNT;
+                r.count = std::atoi(v.c_str());
+                if (r.count <= 0) {
+                    return fail("rule '" + rule + "': layer count must be > 0");
+                }
+            } else {
+                r.kind    = llama_offload_spec_rule::KIND_LAYERS_RANGE;
+                r.layer_a = std::atoi(v.substr(0, dash).c_str());
+                r.layer_b = std::atoi(v.substr(dash + 1).c_str());
+                if (r.layer_a < 0 || r.layer_b < r.layer_a) {
+                    return fail("rule '" + rule + "': bad layer range");
+                }
+            }
+        } else if (what_l.rfind("bytes=", 0) == 0) {
+            r.kind = llama_offload_spec_rule::KIND_BYTES;
+            try {
+                r.bytes = llama_offload_spec_parse_bytes(trim(what.substr(6)));
+            } catch (const std::exception & e) {
+                return fail("rule '" + rule + "': " + e.what());
+            }
+            if (r.bytes <= 0) {
+                return fail("rule '" + rule + "': byte budget must be > 0");
+            }
+        } else {
+            // bare number == layers=N
+            char * end = nullptr;
+            const long n = std::strtol(what.c_str(), &end, 10);
+            if (end == what.c_str() || (end && *end != '\0') || n <= 0) {
+                return fail("rule '" + rule + "': expected N, layers=A-B, layers=N, bytes=N[KMG] or rest");
+            }
+            r.kind  = llama_offload_spec_rule::KIND_LAYERS_COUNT;
+            r.count = (int) n;
+        }
+
+        rules.push_back(r);
+    }
+
+    return rules;
+}
+
+std::vector<std::string> llama_offload_spec_devices(const char * spec) {
+    std::vector<std::string> devs;
+    std::string err;
+    for (const auto & r : llama_offload_spec_parse(spec, &err)) {
+        const std::string l = lower(r.device);
+        if (l == "cpu" || l == "none" || l == "host") {
+            continue;
+        }
+        bool seen = false;
+        for (const auto & d : devs) {
+            if (lower(d) == l) {
+                seen = true;
+                break;
+            }
+        }
+        if (!seen) {
+            devs.push_back(r.device);
+        }
+    }
+    return devs;
+}
