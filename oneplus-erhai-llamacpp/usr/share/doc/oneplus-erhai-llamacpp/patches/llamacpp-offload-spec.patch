diff --git a/src/llama-offload-spec.h b/src/llama-offload-spec.h
new file mode 100644
index 0000000..bd54cdf
--- /dev/null
+++ b/src/llama-offload-spec.h
@@ -0,0 +1,48 @@
+#pragma once
+
+// Exact placement of the repeating layers across devices ("--offload-spec").
+//
+// Grammar: rule[','|';' rule]*
+//   <device>[:]<N>              N consecutive, still unassigned layers (ascending index)
+//   <device>:layers=A-B         layer index range, inclusive and 0-based
+//   <device>:layers=N           same as the bare <N> form
+//   <device>:bytes=<N>[K|M|G]   consecutive unassigned layers until N bytes of weights
+//   <device>:rest               every layer not assigned by an earlier rule
+// <device> is a device name as printed by --list-devices (e.g. HTP0, GPUOpenCL, CPU),
+// matched case-insensitively; the output layer is index <n_layer_all> (usually you only
+// name the repeating layers and let it follow the CPU default).
+//
+// Rules are applied left to right and the first rule that claims a layer wins, so the
+// spec is fully deterministic - unlike n_gpu_layers/tensor_split, which depend on the
+// free memory the backends report (the Hexagon backend reports none).
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+struct llama_offload_spec_rule {
+    enum kind_t {
+        KIND_LAYERS_COUNT, // `N`   -> take the next `n` unassigned layers
+        KIND_LAYERS_RANGE, // `A-B` -> take exactly that range
+        KIND_BYTES,        // `bytes=N` -> fill with whole layers up to `bytes` weight bytes
+        KIND_REST,         // `rest` -> everything still unassigned
+    };
+
+    kind_t      kind = KIND_LAYERS_COUNT;
+    std::string device;       // as written by the user
+    int         layer_a = -1; // KIND_LAYERS_RANGE
+    int         layer_b = -1; // KIND_LAYERS_RANGE (inclusive)
+    int         count   = 0;  // KIND_LAYERS_COUNT
+    int64_t     bytes   = 0;  // KIND_BYTES
+    int         pos     = 0;  // 0-based position in the spec, for diagnostics
+};
+
+// Parse an offload spec.  Throws std::invalid_argument with a readable message on a
+// malformed rule; `err` (when given) receives that message instead of throwing.
+std::vector<llama_offload_spec_rule> llama_offload_spec_parse(const char * spec, std::string * err = nullptr);
+
+// The distinct non-CPU device names mentioned by a spec, in the order they appear.
+std::vector<std::string> llama_offload_spec_devices(const char * spec);
+
+// Human-readable byte budget, e.g. 3G -> 3*1024^3.
+int64_t llama_offload_spec_parse_bytes(const std::string & value);
