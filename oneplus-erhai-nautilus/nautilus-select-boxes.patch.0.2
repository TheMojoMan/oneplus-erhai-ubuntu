+        gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_DENIED);
+        return;
+    }
+
+    g_signal_emit (self, signals[POPUP_BACKGROUND_CONTEXT_MENU], 0, x, y);
+    gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+}
+
+static void
+on_select_swipe_begin (GtkGestureDrag *gesture,
+                       gdouble         start_x,
+                       gdouble         start_y,
+                       gpointer        user_data)
+{
+    NautilusListBase *self = user_data;
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+    NautilusViewCell *cell;
+
+    priv->select_swipe_active = FALSE;
+
+    cell = get_cell_under_select_box (self, start_x, start_y);
+    if (cell == NULL)
+    {
+        gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_DENIED);
+        return;
+    }
+
+    priv->select_swipe_active = TRUE;
+    priv->select_swipe_target = !nautilus_view_cell_is_selected (cell);
+    nautilus_view_cell_set_selected (cell, priv->select_swipe_target);
+
+    gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+}
+
+static void
+on_select_swipe_update (GtkGestureDrag *gesture,
+                        gdouble         offset_x,
+                        gdouble         offset_y,
+                        gpointer        user_data)
+{
+    NautilusListBase *self = user_data;
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+    gdouble start_x, start_y, x, y;
+    NautilusViewCell *cell;
+
+    if (!priv->select_swipe_active)
+    {
+        return;
+    }
+
+    gtk_gesture_drag_get_start_point (gesture, &start_x, &start_y);
+    x = start_x + offset_x;
+    y = start_y + offset_y;
+
+    /* Once a swipe has started on a checkbox, keep toggling whatever item the
+     * finger is over -- even if it drifted off the checkbox column -- and
+     * never start a drag. */
+    cell = get_cell_at (self, x, y);
+    if (cell != NULL)
+    {
+        nautilus_view_cell_set_selected (cell, priv->select_swipe_target);
+    }
+}
+
+static void
+on_select_swipe_end (GtkGestureDrag *gesture,
+                     gdouble         offset_x,
+                     gdouble         offset_y,
+                     gpointer        user_data)
+{
+    NautilusListBase *self = user_data;
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+
+    priv->select_swipe_active = FALSE;
+}
