+/* Selection checkbox support
+ *
+ * A subclass may place a GtkCheckButton in its template and register it with
+ * nautilus_view_cell_setup_select_box(). This base class then keeps it in sync
+ * with the selection model and shows/hides it according to the
+ * "show-select-boxes" preference. It also exposes a small API used by the view
+ * to implement finger swiping over the checkboxes. */
+
+static void update_select_box (NautilusViewCell *self);
+
+static NautilusViewModel *
+get_select_box_model (NautilusViewCell *self)
+{
+    NautilusViewCellPrivate *priv = nautilus_view_cell_get_instance_private (self);
+
+    if (priv->view == NULL)
+    {
+        return NULL;
+    }
+
+    return nautilus_list_base_get_model (priv->view);
+}
+
+static gboolean
+select_box_position_valid (NautilusViewCell  *self,
+                           NautilusViewModel **model_out,
+                           guint              *position_out)
+{
+    NautilusViewCellPrivate *priv = nautilus_view_cell_get_instance_private (self);
+    NautilusViewModel *model = get_select_box_model (self);
+    guint position = priv->position;
+
+    if (model == NULL ||
+        position == GTK_INVALID_LIST_POSITION ||
+        position >= g_list_model_get_n_items (G_LIST_MODEL (model)))
+    {
+        return FALSE;
+    }
+
+    *model_out = model;
+    *position_out = position;
+
+    return TRUE;
+}
+
+static gboolean
+get_select_box_selected (NautilusViewCell *self)
+{
+    NautilusViewModel *model;
+    guint position;
+
+    if (!select_box_position_valid (self, &model, &position))
+    {
+        return FALSE;
+    }
+
+    return gtk_selection_model_is_selected (GTK_SELECTION_MODEL (model), position);
+}
+
+static void
+set_select_box_selected (NautilusViewCell *self,
+                         gboolean          selected)
+{
+    NautilusViewModel *model;
+    guint position;
+
+    if (!select_box_position_valid (self, &model, &position))
+    {
+        return;
+    }
+
+    if (selected)
+    {
+        gtk_selection_model_select_item (GTK_SELECTION_MODEL (model), position, FALSE);
+    }
+    else
+    {
+        gtk_selection_model_unselect_item (GTK_SELECTION_MODEL (model), position);
+    }
+}
+
+static void
+on_select_box_toggled (GtkCheckButton *button,
+                       gpointer        user_data)
+{
+    set_select_box_selected (NAUTILUS_VIEW_CELL (user_data),
+                             gtk_check_button_get_active (button));
+}
+
+static void
+update_select_box (NautilusViewCell *self)
+{
+    NautilusViewCellPrivate *priv = nautilus_view_cell_get_instance_private (self);
+    gboolean show;
+
+    if (priv->select_box == NULL)
+    {
+        return;
+    }
+
+    show = g_settings_get_boolean (nautilus_preferences,
+                                   NAUTILUS_PREFERENCES_SHOW_SELECT_BOXES);
+
+    gtk_widget_set_visible (priv->select_box, show && priv->item != NULL);
+
+    g_signal_handlers_block_by_func (priv->select_box,
+                                     G_CALLBACK (on_select_box_toggled), self);
+    gtk_check_button_set_active (GTK_CHECK_BUTTON (priv->select_box),
+                                 get_select_box_selected (self));
+    g_signal_handlers_unblock_by_func (priv->select_box,
+                                       G_CALLBACK (on_select_box_toggled), self);
+}
+
+static void
+on_selection_changed (NautilusViewModel *model,
+                      guint              position,
+                      guint              n_items,
+                      gpointer           user_data)
+{
+    NautilusViewCell *self = NAUTILUS_VIEW_CELL (user_data);
+    NautilusViewCellPrivate *priv = nautilus_view_cell_get_instance_private (self);
+
+    if (priv->select_box == NULL || priv->position == GTK_INVALID_LIST_POSITION)
+    {
+        return;
+    }
+
+    if (priv->position >= position && priv->position < position + n_items)
+    {
+        update_select_box (self);
+    }
+}
+
+static void
+connect_select_box_model (NautilusViewCell *self)
+{
+    NautilusViewCellPrivate *priv = nautilus_view_cell_get_instance_private (self);
+    NautilusViewModel *model = get_select_box_model (self);
+
+    if (model == priv->select_box_model)
+    {
+        return;
+    }
+
+    priv->select_box_model = model;
+
+    if (model != NULL)
+    {
+        g_signal_connect_object (model, "selection-changed",
+                                 G_CALLBACK (on_selection_changed), self,
+                                 G_CONNECT_DEFAULT);
+    }
+}
+
+static void
+on_cell_select_box_changed (NautilusViewCell *self)
+{
+    connect_select_box_model (self);
+    update_select_box (self);
+}
+
+void
+nautilus_view_cell_setup_select_box (NautilusViewCell *self,
+                                     GtkWidget        *box)
+{
+    NautilusViewCellPrivate *priv = nautilus_view_cell_get_instance_private (self);
+
+    g_return_if_fail (NAUTILUS_IS_VIEW_CELL (self));
+    g_return_if_fail (box != NULL);
+
+    priv->select_box = box;
+
+    /* Marker used by the view to hit-test the checkbox while swiping over it. */
+    g_object_set_data (G_OBJECT (box), "nautilus-select-box", GINT_TO_POINTER (1));
+    gtk_widget_set_visible (box, FALSE);
+
+    g_signal_connect_object (box, "toggled",
+                             G_CALLBACK (on_select_box_toggled), self,
+                             G_CONNECT_DEFAULT);
+    g_signal_connect_object (self, "notify::item",
+                             G_CALLBACK (on_cell_select_box_changed), self,
+                             G_CONNECT_SWAPPED);
+    g_signal_connect_object (self, "notify::position",
+                             G_CALLBACK (on_cell_select_box_changed), self,
+                             G_CONNECT_SWAPPED);
+    g_signal_connect_object (nautilus_preferences,
+                             "changed::" NAUTILUS_PREFERENCES_SHOW_SELECT_BOXES,
+                             G_CALLBACK (on_cell_select_box_changed), self,
+                             G_CONNECT_SWAPPED);
+
+    if (priv->view != NULL)
+    {
+        g_signal_connect_object (priv->view, "notify::model",
+                                 G_CALLBACK (on_cell_select_box_changed), self,
+                                 G_CONNECT_SWAPPED);
+    }
+
+    on_cell_select_box_changed (self);
+}
+
+GtkWidget *
+nautilus_view_cell_get_select_box (NautilusViewCell *self)
+{
+    NautilusViewCellPrivate *priv = nautilus_view_cell_get_instance_private (self);
+
+    g_return_val_if_fail (NAUTILUS_IS_VIEW_CELL (self), NULL);
+
+    return priv->select_box;
+}
+
+void
+nautilus_view_cell_set_selected (NautilusViewCell *self,
+                                 gboolean          selected)
+{
+    g_return_if_fail (NAUTILUS_IS_VIEW_CELL (self));
+
+    set_select_box_selected (self, selected);
+}
+
+gboolean
+nautilus_view_cell_is_selected (NautilusViewCell *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_VIEW_CELL (self), FALSE);
+
+    return get_select_box_selected (self);
+}
+
+/* Extra slack (px) around the checkbox so a finger slightly off it still
+ * counts as "starting on the box". */
+#define SELECT_BOX_TOUCH_MARGIN 10
+
+gboolean
+nautilus_view_cell_point_over_select_box (NautilusViewCell *self,
+                                          double            x,
+                                          double            y)
+{
+    NautilusViewCellPrivate *priv = nautilus_view_cell_get_instance_private (self);
+    graphene_rect_t bounds;
+    graphene_point_t point = GRAPHENE_POINT_INIT (x, y);
+
+    if (priv->select_box == NULL ||
+        !gtk_widget_get_visible (priv->select_box))
+    {
+        return FALSE;
+    }
+
+    if (!gtk_widget_compute_bounds (priv->select_box, GTK_WIDGET (self), &bounds))
+    {
+        return FALSE;
+    }
+
+    graphene_rect_inset (&bounds, -SELECT_BOX_TOUCH_MARGIN, -SELECT_BOX_TOUCH_MARGIN);
+
+    return graphene_rect_contains_point (&bounds, &point);
+}
