+/* [erhai] Touchscreen + on-screen-keyboard fix (2026-10-15).
+ *
+ * The rename popover used to keep GTK's default `autohide`, which makes GTK ask
+ * the compositor for a Wayland popup GRAB.  Mutter ends such a grab on the
+ * RELEASE of any press whose surface belongs to another client -- and the
+ * on-screen keyboard is a SHELL surface, with no client at all, so the first tap
+ * on an OSK key dismissed the rename popover and the typed character was lost
+ * (measured on the pad: the popover closed on the very first key, the entry text
+ * unchanged).  Without the grab (`autohide = FALSE`) the OSK types into the
+ * entry; the two things the grab used to provide are re-implemented here:
+ *   * the entry is given the keyboard focus explicitly when the popover is shown
+ *     (NautilusRenameFilePopover now grabs it in show_for_file()), and
+ *   * a press anywhere else in the parent widget -- the files view -- pops the
+ *     popover down again.
+ * Escape still closes the popover (GtkPopover handles GDK_KEY_Escape itself).
+ *
+ * The controller is installed once per popover (the popover lives as long as the
+ * files view) and does nothing while the popover is hidden; g_signal_connect_object
+ * keeps it valid if this popover is destroyed first. */
+static void
+on_outside_click_pressed (GtkGestureClick           *gesture,
+                          gint                       n_press,
+                          gdouble                    x,
+                          gdouble                    y,
+                          NautilusRenameFilePopover *self)
+{
+    GtkWidget *parent;
+    graphene_rect_t bounds;
+    graphene_point_t point;
+
+    if (!gtk_widget_get_visible (GTK_WIDGET (self)))
+    {
+        return;
+    }
+
+    parent = gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (gesture));
+    point = GRAPHENE_POINT_INIT ((float) x, (float) y);
+
+    if (gtk_widget_compute_bounds (GTK_WIDGET (self), parent, &bounds) &&
+        graphene_rect_contains_point (&bounds, &point))
+    {
+        /* The press is inside the popover: keep it open. */
+        return;
+    }
+
+    gtk_popover_popdown (GTK_POPOVER (self));
+}
+
+static void
+setup_outside_click_controller (NautilusRenameFilePopover *self)
+{
+    GtkWidget *parent;
+
+    if (self->outside_click_controller != NULL)
+    {
+        return;
+    }
+
+    parent = gtk_widget_get_parent (GTK_WIDGET (self));
+    if (parent == NULL)
+    {
+        return;
+    }
+
+    self->outside_click_controller =
+        GTK_EVENT_CONTROLLER (gtk_gesture_click_new ());
+    gtk_event_controller_set_propagation_phase (self->outside_click_controller,
+                                                GTK_PHASE_CAPTURE);
+
+    /* Observes presses without claiming the sequence, so the widget under the
+     * press still gets it. */
+    g_signal_connect_object (self->outside_click_controller, "pressed",
+                             G_CALLBACK (on_outside_click_pressed), self, 0);
+    gtk_widget_add_controller (parent, self->outside_click_controller);
+}
+
 static void
 reset_state (NautilusRenameFilePopover *self)
 {
