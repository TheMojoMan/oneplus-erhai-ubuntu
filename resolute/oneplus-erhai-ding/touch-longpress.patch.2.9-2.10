+    /* erhai: open the desktop context menu anchored at a widget-local point.
+     * Used by the touch long-press shim in desktopGrid.js, which has no
+     * button-3 event to hand to popup_at_pointer.  `_initTouchLongPress` also
+     * appears here so DEBIAN/postinst can tell a patched file from Ubuntu's. */
+    showDesktopContextMenu(x, y, widget, triggerEvent) {
+        this._prepareMenu();
+        if (triggerEvent) {
+            /* the usual path: anchor the menu at the triggering event (the
+             * finger), exactly like the mouse button-3 branch */
+            this._menu.popup_at_pointer(triggerEvent);
+            return;
+        }
+        let window = widget ? widget.get_window() : null;
+        if (window) {
+            let rect = new Gdk.Rectangle({x: Math.floor(x), y: Math.floor(y),
+                                          width: 1, height: 1});
+            this._menu.popup_at_rect(window, rect,
+                Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, null);
+        } else {
+            this._menu.popup_at_pointer(null);
+        }
+    }
