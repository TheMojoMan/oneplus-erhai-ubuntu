--- a/src/wayland/meta-wayland.c
+++ b/src/wayland/meta-wayland.c
@@ -196,6 +196,7 @@
       MetaSurfaceActor *actor;
       MetaWaylandActorSurface *actor_surface;
       gboolean should_flush_frame_callbacks;
+      gboolean is_primary;
 
       l = l->next;
 
@@ -205,10 +206,19 @@
 
       should_flush_frame_callbacks =
         meta_wayland_surface_flush_frame_callbacks (surface);
+      is_primary =
+        meta_surface_actor_wayland_is_view_primary (actor, stage_view);
 
-      if (!should_flush_frame_callbacks &&
-          !meta_surface_actor_wayland_is_view_primary (actor,
-                                                       stage_view))
+      /* Only hold back frame callbacks for clients that are actually hidden.
+       * A visible surface must always get its callback, even when the
+       * primary-view heuristic says otherwise: a client that commits a frame
+       * with no damage then waits forever for a callback that never comes, the
+       * compositor goes idle and the whole presentation chain deadlocks until
+       * something forces a redraw (a workspace switch).  Seen with a fullscreen
+       * video toplevel switching codec: the picture froze while decoding went
+       * on (video-MEMORY-2026-11-19.md). */
+      if (!should_flush_frame_callbacks && !is_primary &&
+          meta_surface_actor_is_effectively_obscured (actor))
         continue;
 
       actor_surface = META_WAYLAND_ACTOR_SURFACE (surface->role);
