+/* Returns the NautilusViewCell containing the given point, if any. */
+static NautilusViewCell *
+get_cell_at (NautilusListBase *self,
+             gdouble           x,
+             gdouble           y)
+{
+    GtkWidget *picked = gtk_widget_pick (GTK_WIDGET (self), x, y, GTK_PICK_DEFAULT);
+
+    for (GtkWidget *w = picked; w != NULL; w = gtk_widget_get_parent (w))
+    {
+        if (NAUTILUS_IS_VIEW_CELL (w))
+        {
+            return NAUTILUS_VIEW_CELL (w);
+        }
+        if (w == GTK_WIDGET (self))
+        {
+            break;
+        }
+    }
+
+    return NULL;
+}
+
+/* Returns the cell whose selection checkbox is under the given point (with a
+ * finger-friendly margin), or NULL. */
+static NautilusViewCell *
+get_cell_under_select_box (NautilusListBase *self,
+                           gdouble           x,
+                           gdouble           y)
+{
+    NautilusViewCell *cell = get_cell_at (self, x, y);
+    graphene_point_t point;
+    graphene_point_t in_cell;
+
+    if (cell == NULL)
+    {
+        return NULL;
+    }
+
+    point = GRAPHENE_POINT_INIT (x, y);
+    if (!gtk_widget_compute_point (GTK_WIDGET (self), GTK_WIDGET (cell),
+                                   &point, &in_cell))
+    {
+        return NULL;
+    }
+
+    if (!nautilus_view_cell_point_over_select_box (cell, in_cell.x, in_cell.y))
+    {
+        return NULL;
+    }
+
+    return cell;
+}
+
+static void
+on_view_longpress_pressed (GtkGestureLongPress *gesture,
+                           gdouble              x,
+                           gdouble              y,
+                           gpointer             user_data)
+{
+    NautilusListBase *self = user_data;
+
+    /* Long-pressing an item is handled by the item's own long-press gesture;
+     * only open the background context menu when the finger is not over an
+     * item. */
+    if (get_cell_at (self, x, y) != NULL)
+    {
+        gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_DENIED);
+        return;
+    }
+
+    g_signal_emit (self, signals[POPUP_BACKGROUND_CONTEXT_MENU], 0, x, y);
+    gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+}
+
+static void
+on_select_swipe_begin (GtkGestureDrag *gesture,
+                       gdouble         start_x,
+                       gdouble         start_y,
+                       gpointer        user_data)
+{
+    NautilusListBase *self = user_data;
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+    NautilusViewCell *cell;
+
+    priv->select_swipe_active = FALSE;
+
+    cell = get_cell_under_select_box (self, start_x, start_y);
+    if (cell == NULL)
+    {
+        gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_DENIED);
+        return;
+    }
+
+    priv->select_swipe_active = TRUE;
+    priv->select_swipe_target = !nautilus_view_cell_is_selected (cell);
+    nautilus_view_cell_set_selected (cell, priv->select_swipe_target);
+
+    gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+}
+
+static void
+on_select_swipe_update (GtkGestureDrag *gesture,
+                        gdouble         offset_x,
+                        gdouble         offset_y,
+                        gpointer        user_data)
+{
+    NautilusListBase *self = user_data;
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+    gdouble start_x, start_y, x, y;
+    NautilusViewCell *cell;
+
+    if (!priv->select_swipe_active)
+    {
+        return;
+    }
+
+    gtk_gesture_drag_get_start_point (gesture, &start_x, &start_y);
+    x = start_x + offset_x;
+    y = start_y + offset_y;
+
+    /* Once a swipe has started on a checkbox, keep toggling whatever item the
+     * finger is over -- even if it drifted off the checkbox column -- and
+     * never start a drag. */
+    cell = get_cell_at (self, x, y);
+    if (cell != NULL)
+    {
+        nautilus_view_cell_set_selected (cell, priv->select_swipe_target);
+    }
+}
+
+static void
+on_select_swipe_end (GtkGestureDrag *gesture,
+                     gdouble         offset_x,
+                     gdouble         offset_y,
+                     gpointer        user_data)
+{
+    NautilusListBase *self = user_data;
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+
+    priv->select_swipe_active = FALSE;
+}
