+
+      can_paste = gdk_content_formats_contain_gtype (gdk_clipboard_get_formats (clipboard), G_TYPE_STRING);
+    }
+
+  gtk_widget_action_set_enabled (GTK_WIDGET (self), "win.paste", can_paste);
+}
